# Development binds to localhost. Production needs a password by default.
JOTSTEAD_PASSWORD=
JOTSTEAD_DATA_DIR=data
# Set the exact external origin when running behind a reverse proxy.
# JOTSTEAD_PUBLIC_URL=https://jotstead.example.com
# JOTSTEAD_COOKIE_SECURE=1
# Optional personal API credential. Never put this in a NEXT_PUBLIC variable.
# JOTSTEAD_API_TOKEN=
# Local-only production preview: use only with loopback bind, never a public server.
# JOTSTEAD_LOCAL_ONLY=1
# Optional AI: OpenAI-compatible /v1 base URL. Keys remain server-side.
# JOTSTEAD_AI_URL=http://127.0.0.1:11434/v1
# JOTSTEAD_AI_MODEL=llama3.2
# JOTSTEAD_AI_KEY=
