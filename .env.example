# Local launch commands open the workspace directly on http://127.0.0.1.
# ChatGPT connection is optional in Settings.
# Leave unset for initial local dynamic registration. Only set a real OpenAI-issued
# LOCAL client with this runtime's http://127.0.0.1:<port>/auth/callback registration.
# A made-up oaiapp_ value or a hosted website client does not enable local registration.
# JOTSTEAD_CHATGPT_CLIENT_ID=
# Optional existing password deployment before ChatGPT owner binding.
JOTSTEAD_PASSWORD=
JOTSTEAD_DATA_DIR=data
# Set the exact external origin when running behind a reverse proxy.
# JOTSTEAD_PUBLIC_URL=https://jotstead.example.com
# JOTSTEAD_COOKIE_SECURE=1
# Optional personal API credential. Never put this in a NEXT_PUBLIC variable.
# JOTSTEAD_API_TOKEN=
# Opt out of direct local access and require authentication:
# JOTSTEAD_LOCAL_ONLY=0
# Optional AI: OpenAI-compatible /v1 base URL. Keys remain server-side.
# JOTSTEAD_AI_URL=http://127.0.0.1:11434/v1
# JOTSTEAD_AI_MODEL=llama3.2
# JOTSTEAD_AI_KEY=
