{
  "name": "jotstead",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx scripts/backup.ts",
    "check": "pnpm test && pnpm typecheck && pnpm build && pnpm verify:http",
    "format": "prettier --write src tests scripts public/sw.js next.config.ts vitest.config.ts tsconfig.json package.json",
    "mcp": "tsx scripts/mcp.ts",
    "verify:http": "tsx scripts/verify-http.ts",
    "preview": "node scripts/start.mjs --local"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@phosphor-icons/react": "2.1.10",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-details": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "idb-keyval": "^6.2.2",
    "jose": "^6.2.12",
    "jsep": "^1.4.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
